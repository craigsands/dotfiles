#!/bin/sh
# Claude CLI Status Line
# ======================
#
# Custom status line for Claude CLI with ANSI color coding.
#
# FEATURES
# --------
# - Color-coded model names (Opus=orange, Sonnet=green, Haiku=yellow)
# - Mode badges: [MAX] (red), [THINK] (yellow)
# - Context window progress bar with color-coded percentage
# - Session metrics: cost, tokens, duration
# - Git branch and directory info
#
# CONFIGURATION
# -------------
# The script reads your current Claude CLI settings from ~/.claude/settings.json
# (maintained by Claude CLI).
#
# Mode badges appear based on your selections in Claude:
# - [MAX] badge: When you select a model with "max" in the name
# - [THINK] badge: When you enable thinking mode
#
# Configure Claude CLI to use this status line:
#    claude config set statusline.command "~/code/craigsands/dotfiles/bin/claude-statusline"
#
# Or add to Claude CLI config:
#    {
#      "statusline": {
#        "command": "~/code/craigsands/dotfiles/bin/claude-statusline"
#      }
#    }
#
# MANUAL TESTING
# --------------
# Test with sample JSON:
#   cat << 'EOF' | ~/code/craigsands/dotfiles/bin/claude-statusline
#   {
#     "model": {
#       "display_name": "Claude 3.5 Sonnet",
#       "id": "claude-3-5-sonnet-20241022"
#     },
#     "context_window": {
#       "used_percentage": 42,
#       "context_window_size": 200000,
#       "total_input_tokens": 50000,
#       "total_output_tokens": 34000
#     },
#     "workspace": {
#       "current_dir": "/Users/user/code/project"
#     },
#     "cost": {
#       "total_cost_usd": 0.05,
#       "total_duration_ms": 12000
#     }
#   }
#   EOF
#
# EXAMPLE OUTPUT
# --------------
# Sonnet [THINK]  [████████░░░░░░░░░░░░] 42% /200k  dotfiles (main)  $0.05  8k tok  12s
#
# CUSTOMIZATION
# -------------
# Model name colors (line ~120):
#   - Opus: Orange background (ANSI 256-color 208)
#   - Sonnet: Green text (ANSI 32)
#   - Haiku: Yellow text (ANSI 33)
#
# Context window color thresholds (line ~185):
#   - Green: < 45% usage
#   - Yellow: 45-55% usage
#   - Orange: 55-65% usage
#   - Red: > 65% usage
#
# Mode detection field names (line ~75):
#   - Max mode: checks 'model' field contains "max"
#   - Thinking: checks 'thinking', 'extendedThinking', or 'enableThinking'
#
# REQUIREMENTS
# ------------
# - jq (JSON parser): brew install jq
# - ANSI color support in terminal
# - Claude CLI with status line support

# ── Configuration ─────────────────────────────────────────────────────────────

SETTINGS="$HOME/.claude/settings.json"

# ANSI reset
RST='\033[0m'

# ── Parse JSON Input ──────────────────────────────────────────────────────────

input=$(cat)

model=$(printf '%s' "$input" | jq -r '.model.display_name // .model.id // "Claude"')
used=$(printf '%s' "$input" | jq -r '.context_window.used_percentage // empty')
ctx_size=$(printf '%s' "$input" | jq -r '.context_window.context_window_size // empty')
cwd=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // ""')
[ -z "$cwd" ] && cwd="$PWD"

# Session metrics
cost_usd=$(printf '%s' "$input" | jq -r '.cost.total_cost_usd // empty')
total_tokens=$(printf '%s' "$input" | jq -r '
  ((.context_window.total_input_tokens // 0) + (.context_window.total_output_tokens // 0))
  | if . > 0 then tostring else empty end
')
duration_ms=$(printf '%s' "$input" | jq -r '.cost.total_duration_ms // empty')

# Agent/worktree info
worktree_name=$(printf '%s' "$input" | jq -r '.worktree.name // empty')
agent_name=$(printf '%s' "$input" | jq -r '.agent.name // empty')

model_lower=$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')

# ── Detect Modes from Settings ───────────────────────────────────────────────

is_max=0
is_thinking=0

if [ -f "$SETTINGS" ]; then
    # Max mode: check if model contains "max"
    settings_model=$(jq -r '.model // ""' "$SETTINGS" 2>/dev/null)
    settings_model_lower=$(printf '%s' "$settings_model" | tr '[:upper:]' '[:lower:]')
    case "$settings_model_lower" in
        *max*) is_max=1 ;;
    esac

    # Thinking mode: check multiple field names (adjust if your config differs)
    thinking_val=$(jq -r '.thinking // .extendedThinking // .enableThinking // "false"' "$SETTINGS" 2>/dev/null)
    case "$thinking_val" in
        true|1|yes|enabled) is_thinking=1 ;;
    esac
fi

# Also detect max mode from stdin model name
case "$model_lower" in
    *max*) is_max=1 ;;
esac

# ── Git Branch and Directory ──────────────────────────────────────────────────

folder=$(basename "$cwd")
git_branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)

location_out=$(printf '\033[36m%s\033[0m' "$folder")
if [ -n "$git_branch" ]; then
    location_out="${location_out}$(printf ' \033[90m(%s)\033[0m' "$git_branch")"
fi

# ── Color Model Name ──────────────────────────────────────────────────────────

case "$model_lower" in
    *opus*)
        # Orange background (256-color 208), black text
        model_out=$(printf '\033[48;5;208m\033[30m %s \033[0m' "$model")
        ;;
    *sonnet*)
        # Green text
        model_out=$(printf '\033[32m%s\033[0m' "$model")
        ;;
    *haiku*)
        # Yellow text
        model_out=$(printf '\033[33m%s\033[0m' "$model")
        ;;
    *)
        model_out="$model"
        ;;
esac

# ── Mode Badges ───────────────────────────────────────────────────────────────

badges=""
if [ "$is_max" = "1" ]; then
    # Red background, black text
    badges="${badges}$(printf ' \033[41m\033[30m MAX \033[0m')"
fi
if [ "$is_thinking" = "1" ]; then
    # Yellow text
    badges="${badges}$(printf ' \033[33mTHINK\033[0m')"
fi

# ── Context Window Size Suffix ────────────────────────────────────────────────

ctx_size_out=""
if [ -n "$ctx_size" ]; then
    ctx_size_k=$(printf '%s' "$ctx_size" | awk '{printf "%dk", int($1/1000 + 0.5)}')
    ctx_size_out=$(printf ' \033[90m/%s\033[0m' "$ctx_size_k")
fi

# ── Agent/Worktree Badges ─────────────────────────────────────────────────────

extra_badges=""
if [ -n "$agent_name" ]; then
    extra_badges="${extra_badges}$(printf ' \033[36m[%s]\033[0m' "$agent_name")"
fi
if [ -n "$worktree_name" ]; then
    extra_badges="${extra_badges}$(printf ' \033[90m[wt:%s]\033[0m' "$worktree_name")"
fi

# ── Format Session Metrics ────────────────────────────────────────────────────

cost_out=""
if [ -n "$cost_usd" ]; then
    cost_fmt=$(printf '%s' "$cost_usd" | awk '{printf "$%.2f", $1}')
    cost_out=$(printf '  \033[90m%s\033[0m' "$cost_fmt")
fi

tokens_out=""
if [ -n "$total_tokens" ]; then
    tokens_fmt=$(printf '%s' "$total_tokens" | awk '{
        if ($1 >= 1000) printf "%dk tok", int($1/1000 + 0.5)
        else printf "%d tok", $1
    }')
    tokens_out=$(printf '  \033[90m%s\033[0m' "$tokens_fmt")
fi

duration_out=""
if [ -n "$duration_ms" ]; then
    duration_fmt=$(printf '%s' "$duration_ms" | awk '{
        s = int($1/1000)
        m = int(s/60)
        s = s % 60
        if (m > 0) printf "%dm %ds", m, s
        else printf "%ds", s
    }')
    duration_out=$(printf '  \033[90m%s\033[0m' "$duration_fmt")
fi

# ── Render Status Line ────────────────────────────────────────────────────────

if [ -z "$used" ]; then
    # No context window data available
    printf '%b%b  %b%b%b%b%b' "$model_out" "$badges" "$location_out" "$extra_badges" "$cost_out" "$tokens_out" "$duration_out"
else
    # Calculate progress bar
    filled=$(printf '%s' "$used" | awk '{printf "%d", int($1 * 20 / 100 + 0.5)}')
    [ "$filled" -gt 20 ] && filled=20
    empty=$((20 - filled))

    used_int=$(printf '%s' "$used" | awk '{printf "%d", int($1 + 0.5)}')

    # Color-code by usage threshold (customize these values as needed)
    if [ "$used_int" -lt 45 ]; then
        ctx_color='\033[38;5;28m'  # Green
    elif [ "$used_int" -lt 55 ]; then
        ctx_color='\033[33m'        # Yellow
    elif [ "$used_int" -lt 65 ]; then
        ctx_color='\033[38;5;208m'  # Orange
    else
        ctx_color='\033[31m'        # Red
    fi

    grey='\033[90m'

    # Build filled portion of bar
    filled_bar=$(printf '%b' "$ctx_color")
    i=0
    while [ "$i" -lt "$filled" ]; do
        filled_bar="${filled_bar}█"
        i=$((i + 1))
    done
    filled_bar="${filled_bar}$(printf '%b' "$RST")"

    # Build empty portion of bar
    empty_bar=$(printf '%b' "$grey")
    i=0
    while [ "$i" -lt "$empty" ]; do
        empty_bar="${empty_bar}░"
        i=$((i + 1))
    done
    empty_bar="${empty_bar}$(printf '%b' "$RST")"

    # Output full status line with context window
    printf '%b%b  [%s%s] %b%s%%%b%b  %b%b%b%b%b' \
        "$model_out" "$badges" \
        "$filled_bar" "$empty_bar" \
        "$ctx_color" "$used_int" "$RST" "$ctx_size_out" \
        "$location_out" "$extra_badges" \
        "$cost_out" "$tokens_out" "$duration_out"
fi
